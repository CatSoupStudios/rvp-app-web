---
// src/components/ServiceGallery.astro
//
// Mosaico "Curated Gallery" de las páginas de servicio. La estructura (tres
// columnas, proporciones de cada hueco, posición del bloque de cita) es del
// diseño y es idéntica en las cuatro páginas; sólo cambia el contenido.
import type { ServicePage } from "../lib/content";

interface Props {
  gallery: ServicePage["gallery"];
}

const { gallery } = Astro.props;
const [first, second, third, fourth, fifth] = gallery.images;
---

<div class="bg-[#080808] py-24 md:py-32 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    <div
      class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6"
    >
      <div>
        <span
          class="text-xs font-medium tracking-[0.2em] uppercase text-[var(--brand-blue)] mb-2 block"
          >{gallery.eyebrow}</span
        >
        <h3 class="text-3xl font-light text-white">{gallery.heading}</h3>
      </div>
      <a
        href={gallery.ctaHref}
        class="text-xs uppercase tracking-widest border-b border-gray-600 pb-1 hover:text-[var(--brand-blue)] hover:border-[var(--brand-blue)] transition-colors"
      >
        {gallery.ctaLabel}
      </a>
    </div>

    <!-- Grid Masonry -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8">
      <!-- Col 1 -->
      <div class="space-y-4 md:space-y-8">
        <div class="overflow-hidden group relative">
          <img
            src={first.image}
            class="w-full object-cover aspect-[3/4] transition duration-700 group-hover:scale-105 group-hover:opacity-80"
            alt={first.alt}
          />
          {
            first.caption && (
              <div class="absolute bottom-4 left-4 opacity-0 group-hover:opacity-100 transition duration-500">
                <p class="text-xs uppercase tracking-widest text-white">
                  {first.caption}
                </p>
              </div>
            )
          }
        </div>
        <div class="overflow-hidden group relative">
          <img
            src={second.image}
            class="w-full object-cover aspect-square transition duration-700 group-hover:scale-105 group-hover:opacity-80"
            alt={second.alt}
          />
          {
            second.caption && (
              <div class="absolute bottom-4 left-4 opacity-0 group-hover:opacity-100 transition duration-500">
                <p class="text-xs uppercase tracking-widest text-white">
                  {second.caption}
                </p>
              </div>
            )
          }
        </div>
      </div>

      <!-- Col 2 -->
      <div class="space-y-4 md:space-y-8 md:pt-12">
        <div class="overflow-hidden group relative">
          <img
            src={third.image}
            class="w-full object-cover aspect-[4/5] transition duration-700 group-hover:scale-105 group-hover:opacity-80"
            alt={third.alt}
          />
          {
            third.caption && (
              <div class="absolute bottom-4 left-4 opacity-0 group-hover:opacity-100 transition duration-500">
                <p class="text-xs uppercase tracking-widest text-white">
                  {third.caption}
                </p>
              </div>
            )
          }
        </div>
        <div
          class="bg-[#111] p-8 flex items-center justify-center aspect-square text-center"
        >
          <div>
            <p class="font-serif text-2xl text-gray-500 italic mb-2">
              {gallery.quote.text}
            </p>
            <p class="text-xs uppercase tracking-widest text-gray-700">
              {gallery.quote.author}
            </p>
          </div>
        </div>
      </div>

      <!-- Col 3 -->
      <div class="space-y-4 md:space-y-8">
        <div class="overflow-hidden group relative">
          <img
            src={fourth.image}
            class="w-full object-cover aspect-square transition duration-700 group-hover:scale-105 group-hover:opacity-80"
            alt={fourth.alt}
          />
          {
            fourth.caption && (
              <div class="absolute bottom-4 left-4 opacity-0 group-hover:opacity-100 transition duration-500">
                <p class="text-xs uppercase tracking-widest text-white">
                  {fourth.caption}
                </p>
              </div>
            )
          }
        </div>
        <div class="overflow-hidden group relative">
          <img
            src={fifth.image}
            class="w-full object-cover aspect-[3/4] transition duration-700 group-hover:scale-105 group-hover:opacity-80"
            alt={fifth.alt}
          />
          {
            fifth.caption && (
              <div class="absolute bottom-4 left-4 opacity-0 group-hover:opacity-100 transition duration-500">
                <p class="text-xs uppercase tracking-widest text-white">
                  {fifth.caption}
                </p>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>
